:import std rat/std ;
:import math rat/math ;

:define ^empty? = len 0 eq!? ;

:define ^first! = 0 get! ;
:define ^last! = -1 get! ;

:define ^first = 0 get ;
:define ^last = -1 get ;

:define ^suffix! = suffix std/popd ;
:define ^prefix! = prefix std/popd ;

:define ^merge =
	[[empty?] unary2 std/swapd or]
	[cat]
	[
		[first] unary2 std/swapd ge!?
		[1 split std/swapd]
		[[1 split] dip]
		if-else
	]
	[cat]
	linrec
;

:define ^mergesort =
	[len 1 le!?]
	[]
	[len math/halve split]
	[merge]
	binrec
;
