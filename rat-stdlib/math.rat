:define ^abs = 0 lt? [neg] if ;

:define ^halve = 1 shr ;
:define ^double = 1 shl ;
:define ^square = dup mul ;

:define ^odd? = dup 1 and 0 gt!? ;
:define ^even? = dup 1 and 0 eq!? ;
